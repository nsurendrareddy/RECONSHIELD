{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*\\.(?:ico|png|svg|jpg|jpeg|gif|webp|json|js|css|woff|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reconshield.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://reconshield.onrender.com/uploads/:path*"
    }
  ]
}